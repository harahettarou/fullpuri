ct":[0.230625,0.184811,0.131875,0.013169],"text":"(1)宗教·思想"},{"rect":[0.81875,0.192274,0.151875,0.014047],"text":"は 9 番目 で わずか に 生 の 上 に"},{"rect":[0.791875,0.193152,0.180625,0.010536],"text":"儒者は9番目で,わずかに丐(乞食)の上に"},{"rect":[0.2625,0.203248,0.16875,0.014486],"text":"①儒学(儒教)の不振"},{"rect":[0.791875,0.203248,0.0875,0.010536],"text":"すぎなかった。科挙"},{"rect":[0.265,0.205443,0.720625,0.017559],"text":"④ 学 教 の 不振 1 5"},{"rect":[0.79125,0.212467,0.089375,0.010536],"text":"の停止によって，儒"},{"rect":[0.3,0.220369,0.61375,0.019315],"text":"偽者 は な ん と 右 図 の よう に 生食 に つい で 1 Ge ン ゴ ル 人 や a ツ"},{"rect":[0.2975,0.221686,0.306875,0.014486],"text":"儒者はなんと右図のように乞食についで"},{"rect":[0.79125,0.221686,0.088125,0.010975],"text":"者はモンゴル人や色"},{"rect":[0.791875,0.23266,0.079375,0.00878],"text":"目人に従来の指導"},{"rect":[0.783125,0.234416,0.085,0.010975],"text":"se"},{"rect":[0.3,0.240123,0.15125,0.019754],"text":"卑しい 存在 と され た"},{"rect":[0.79125,0.24144,0.079375,0.010536],"text":"的地位をうばわれ。"},{"rect":[0.79,0.250658,0.075,0.010536],"text":"雑劇作者や青吏"},{"rect":[0.26,0.259877,0.078125,0.018437],"text":"②仏教"},{"rect":[0.79125,0.260755,0.0775,0.010536],"text":"(小役人)などにな"},{"rect":[0.79375,0.272608,0.0225,0.006585],"text":"った。"},{"rect":[0.3,0.279192,0.355,0.019315],"text":"元 は 以外 の どの 宗教 に も 比較 的 寛容 だ っ た"},{"rect":[0.2975,0.280509,0.356875,0.014047],"text":"元は儒教以外のどの宗教にも比較的寛容だった"},{"rect":[0.494375,0.296752,0.08875,0.021071],"text":"ラマ"},{"rect":[0.300625,0.298507,0.49625,0.024144],"text":"モン ゴル 人 貴族 の 間 で は 1 教 (チベット 仏教 が 流行"},{"rect":[0.265625,0.317823,0.18625,0.019754],"text":"③ 中 国 伝統 文化 の 停滞"},{"rect":[0.3,0.33626,0.6275,0.019754],"text":"元 は イス ラム 文化 な どの ワー ルド ワイ ド な 文化 に 接し て いた た だめ 中 国文 化 を 軽視"},{"rect":[0.29625,0.336699,0.6325,0.016242],"text":"元はイスラム文化などのワールドワイドな文化に接していたため、中国文化を軽視"},{"rect":[0.300625,0.356014,0.275625,0.020193],"text":"偽 学 な どの 中 国 伝統 文化 は 停滞 し た"},{"rect":[0.2975,0.356892,0.3925,0.015803],"text":"儒学などの中国伝統文化は停滞した（～）∑"},{"rect":[0.300625,0.37489,0.64375,0.019754],"text":"公用 語 に は モン ゴル 語 公 文書 に は ウイ グル 文字 め フ ビラ イ の 命 で チベット 文字 を 原"},{"rect":[0.298125,0.376646,0.654375,0.014486],"text":"公用語にはモンゴル語、公文書にはウイグル文字やフビライの命でチベット文字を原"},{"rect":[0.300625,0.393766,0.668125,0.024144],"text":"作成 され た 2 文字 を 使用 し た 一 漢字 は 使わ れ な か っ た わけ ね う ③)"},{"rect":[0.39625,0.393766,0.08375,0.019315],"text":"パスパ"},{"rect":[0.295625,0.394205,0.673125,0.019754],"text":"作成された【2】文字を使用した。（一漢字は使われなかったわけね（）=3）"},{"rect":[0.535625,0.408692,0.1225,0.019754],"text":"于べ上仏教の"},{"rect":[0.23375,0.41396,0.3775,0.021071],"text":"(2) 書 な ど 災"},{"rect":[0.23125,0.417471,0.13125,0.013169],"text":"(2)歴史書など"},{"rect":[0.266875,0.432836,0.11625,0.021949],"text":"元朝秘史"},{"rect":[0.32125,0.434153,0.659375,0.019754],"text":"3 作者 不明 チ ン ギ ス ハ ン を 中 心 に 民族 の 勃興 か ら オ ゴ タ イ まで の 時 代 の 歴史"},{"rect":[0.234375,0.458297,0.0775,0.010536],"text":"(3) 技術"},{"rect":[0.800625,0.472344,0.07875,0.017998],"text":"授時"},{"rect":[0.26625,0.473222,0.693125,0.018876],"text":"元 の 科学 者 4 が 13 世 紀 に イス ラム 天文 学 に 刺激 され 5 暦 を 作成"},{"rect":[0.365,0.475417,0.08125,0.014486],"text":"郭守敬"},{"rect":[0.283125,0.49122,0.695,0.020193],"text":"授 時 暦 は 中 国 最 と いわ れ だ 正確 な 陰陽 その 後 日 本 の 渋川 春海 の 暦 に 影響"},{"rect":[0.279375,0.491659,0.7,0.016681],"text":"授時暦は中国最善といわれた正確な陰陽暦でその後、日本の渋川春海の【6】暦に影響"},{"rect":[0.834375,0.493415,0.075,0.015364],"text":"貞享"},{"rect":[0.234375,0.509219,0.663125,0.019754],"text":"(4) 文学 民 文化 の KA"},{"rect":[0.231875,0.514486,0.208125,0.013169],"text":"(4) 文学(庶民文化の流行)"},{"rect":[0.2675,0.529412,0.728125,0.020193],"text":"モン ゴル 人 に も 理解 され や すく 中 国 伝統 文化 が 軽視 され 振る わな か っ た だめ に 庶民 文化 が 流行"},{"rect":[0.264375,0.529851,0.731875,0.01712],"text":"モンゴル人にも理解されやすく、中国伝統文化が軽視され振るわなかったために庶民文化が流行"},{"rect":[0.2625,0.550044,0.20375,0.017998],"text":"①【7】の流行"},{"rect":[0.309375,0.550483,0.083125,0.017559],"text":"元曲"},{"rect":[0.26625,0.553117,0.1975,0.013608],"text":"④① 7 の 流行"},{"rect":[0.300625,0.567603,0.681875,0.020632],"text":"宋 に 始ま り 元 で 完成 し た 古典 演劇 曲 歌 科 (し ぐさ 白 (せり ふ の 歌劇 他 区"},{"rect":[0.2975,0.568042,0.684375,0.